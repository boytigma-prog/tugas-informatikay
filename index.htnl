<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Berpikir Komputasional - Muhammad Robby Yanur</title>

<style>
*{
        margin:0;
            padding:0;
                box-sizing:border-box;
                    font-family:Arial,sans-serif;
}

html{
        scroll-behavior:smooth;
}

body{
        background:#050505;
            color:white;
                overflow-x:hidden;
}

/* AURA MERAH BERGERAK */
.aura{
        position:fixed;
            width:350px;
                height:350px;
                    border-radius:50%;
                        background:#ff003c;
                            filter:blur(120px);
                                opacity:.22;
                                    z-index:-1;
}

.aura1{
        top:-150px;
            left:-150px;
                animation:move1 8s infinite alternate ease-in-out;
}

.aura2{
        right:-150px;
            bottom:-150px;
                animation:move2 10s infinite alternate ease-in-out;
}

.aura3{
        top:45%;
            left:45%;
                width:250px;
                    height:250px;
                        opacity:.12;
                            animation:move3 7s infinite alternate ease-in-out;
}

@keyframes move1{
        0%{transform:translate(0,0) scale(1);}
            100%{transform:translate(500px,300px) scale(1.3);}
}

@keyframes move2{
        0%{transform:translate(0,0) scale(1);}
            100%{transform:translate(-450px,-350px) scale(1.4);}
}

@keyframes move3{
        0%{transform:translate(-150px,-100px);}
            100%{transform:translate(200px,180px);}
}

/* NAVBAR */
nav{
        position:fixed;
            top:0;
                width:100%;
                    padding:18px 8%;
                        display:flex;
                            justify-content:space-between;
                                align-items:center;
                                    background:rgba(0,0,0,.65);
                                        backdrop-filter:blur(15px);
                                            border-bottom:1px solid #222;
                                                z-index:100;
}

.logo{
        font-weight:bold;
            letter-spacing:3px;
}

.logo span{
        color:#ff003c;
}

nav a{
        color:#aaa;
            text-decoration:none;
                margin-left:20px;
                    font-size:13px;
}

nav a:hover{
        color:#ff003c;
}

/* HERO */
.hero{
        min-height:100vh;
            display:flex;
                justify-content:center;
                    align-items:center;
                        text-align:center;
                            padding:100px 20px;
}

.hero-content{
        max-width:800px;
}

.tag{
        color:#ff003c;
            letter-spacing:5px;
                font-size:12px;
                    margin-bottom:20px;
}

.hero h1{
        font-size:clamp(45px,10vw,90px);
            line-height:1;
}

.hero h1 span{
        color:#ff003c;
            text-shadow:0 0 30px #ff003c;
}

.hero p{
        color:#999;
            line-height:1.7;
                max-width:600px;
                    margin:25px auto;
}

/* IDENTITAS */
.identity{
        margin:30px auto;
            padding:20px 28px;
                width:fit-content;
                    min-width:300px;
                        border-left:3px solid #ff003c;
                            border-right:3px solid #ff003c;
                                background:rgba(255,0,60,.05);
                                    border-radius:12px;
}

.identity p{
        margin:0;
            color:#777;
                font-size:12px;
                    letter-spacing:2px;
}

.identity h2{
        margin:8px 0;
            font-size:21px;
}

.identity span{
        color:#ff003c;
            font-size:11px;
                letter-spacing:2px;
}

.button{
        display:inline-block;
            padding:14px 25px;
                border:1px solid #ff003c;
                    border-radius:30px;
                        color:white;
                            text-decoration:none;
                                transition:.3s;
}

.button:hover{
        background:#ff003c;
            box-shadow:0 0 30px rgba(255,0,60,.7);
}

/* SECTION */
section{
        padding:100px 8%;
}

.title{
        font-size:40px;
            margin-bottom:15px;
}

.title span{
        color:#ff003c;
}

.subtitle{
        color:#777;
            margin-bottom:40px;
}

/* CARDS */
.cards{
        display:grid;
            grid-template-columns:repeat(2,1fr);
                gap:20px;
}

.card{
        padding:30px;
            border:1px solid #222;
                border-radius:20px;
                    background:rgba(255,255,255,.025);
                        transition:.3s;
}

.card:hover{
        transform:translateY(-8px);
            border-color:#ff003c;
                box-shadow:0 15px 40px rgba(255,0,60,.12);
}

.number{
        font-size:14px;
            color:#ff003c;
                letter-spacing:3px;
}

.card h3{
        margin:15px 0 10px;
            font-size:24px;
}

.card p{
        color:#888;
            line-height:1.7;
}

/* CONTOH */
.example{
        max-width:850px;
            padding:30px;
                border-left:3px solid #ff003c;
                    background:#0b0b0b;
                        border-radius:10px;
}

.example h3{
        margin-bottom:15px;
}

.example p{
        color:#999;
            line-height:1.8;
}

/* FOOTER */
footer{
        text-align:center;
            padding:50px 20px;
                border-top:1px solid #151515;
                    color:#555;
}

footer span{
        color:#ff003c;
}

/* MOBILE */
@media(max-width:700px){

        nav{
                    padding:18px 5%;
        }

            nav a{
                        font-size:10px;
                                margin-left:8px;
            }

                section{
                            padding:80px 6%;
                }

                    .cards{
                                grid-template-columns:1fr;
                    }

                        .title{
                                    font-size:32px;
                        }

                            .identity{
                                        min-width:0;
                                                width:90%;
                            }

}
</style>
</head>

<body>

<!-- AURA -->
<div class="aura aura1"></div>
<div class="aura aura2"></div>
<div class="aura aura3"></div>


<!-- NAVBAR -->
<nav>

    <div class="logo">
            INFO<span>.</span>
                </div>

                    <div>
                            <a href="#pengertian">PENGERTIAN</a>
                                    <a href="#konsep">KONSEP</a>
                                            <a href="#contoh">CONTOH</a>
                                                </div>

                                                </nav>


                                                <!-- HALAMAN DEPAN -->
                                                <section class="hero">

                                                    <div class="hero-content">

                                                            <div class="tag">
                                                                        TUGAS INFORMATIKA
                                                                                </div>

                                                                                        <h1>
                                                                                                    BERPIKIR <span>KOMPUTASIONAL</span>
                                                                                                            </h1>

                                                                                                                    <p>
                                                                                                                                Cara berpikir untuk menyelesaikan masalah
                                                                                                                                            secara logis, sistematis, dan efisien.
                                                                                                                                                    </p>

                                                                                                                                                            <div class="identity">

                                                                                                                                                                        <p>DIKERJAKAN OLEH</p>

                                                                                                                                                                                    <h2>
                                                                                                                                                                                                    Muhammad Robby Yanur
                                                                                                                                                                                                                </h2>

                                                                                                                                                                                                                            <span>
                                                                                                                                                                                                                                            TUGAS INFORMATIKA
                                                                                                                                                                                                                                                        </span>

                                                                                                                                                                                                                                                                </div>

                                                                                                                                                                                                                                                                        <a href="#pengertian" class="button">
                                                                                                                                                                                                                                                                                    MULAI BELAJAR
                                                                                                                                                                                                                                                                                            </a>

                                                                                                                                                                                                                                                                                                </div>

                                                                                                                                                                                                                                                                                                </section>


                                                                                                                                                                                                                                                                                                <!-- PENGERTIAN -->
                                                                                                                                                                                                                                                                                                <section id="pengertian">

                                                                                                                                                                                                                                                                                                    <h2 class="title">
                                                                                                                                                                                                                                                                                                            APA ITU <span>BERPIKIR KOMPUTASIONAL?</span>
                                                                                                                                                                                                                                                                                                                </h2>

                                                                                                                                                                                                                                                                                                                    <p class="subtitle">
                                                                                                                                                                                                                                                                                                                            Dasar penting dalam pemecahan masalah.
                                                                                                                                                                                                                                                                                                                                </p>

                                                                                                                                                                                                                                                                                                                                    <div class="example">

                                                                                                                                                                                                                                                                                                                                            <h3>Pengertian</h3>

                                                                                                                                                                                                                                                                                                                                                    <p>
                                                                                                                                                                                                                                                                                                                                                                Berpikir komputasional adalah metode berpikir
                                                                                                                                                                                                                                                                                                                                                                            untuk menyelesaikan masalah dengan cara yang
                                                                                                                                                                                                                                                                                                                                                                                        terstruktur dan logis. Konsep ini tidak hanya
                                                                                                                                                                                                                                                                                                                                                                                                    digunakan dalam pemrograman, tetapi juga dapat
                                                                                                                                                                                                                                                                                                                                                                                                                diterapkan dalam kehidupan sehari-hari.
                                                                                                                                                                                                                                                                                                                                                                                                                        </p>

                                                                                                                                                                                                                                                                                                                                                                                                                            </div>

                                                                                                                                                                                                                                                                                                                                                                                                                            </section>


                                                                                                                                                                                                                                                                                                                                                                                                                            <!-- 4 KONSEP -->
                                                                                                                                                                                                                                                                                                                                                                                                                            <section id="konsep">

                                                                                                                                                                                                                                                                                                                                                                                                                                <h2 class="title">
                                                                                                                                                                                                                                                                                                                                                                                                                                        4 KONSEP <span>UTAMA</span>
                                                                                                                                                                                                                                                                                                                                                                                                                                            </h2>

                                                                                                                                                                                                                                                                                                                                                                                                                                                <p class="subtitle">
                                                                                                                                                                                                                                                                                                                                                                                                                                                        Empat bagian penting dalam berpikir komputasional.
                                                                                                                                                                                                                                                                                                                                                                                                                                                            </p>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                <div class="cards">

                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <div class="card">

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <div class="number">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    01 / DEKOMPOSISI
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <h3>Memecah Masalah</h3>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        Membagi masalah besar menjadi beberapa
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bagian kecil sehingga lebih mudah untuk
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        dipahami dan diselesaikan.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </p>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </div>


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <div class="card">

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <div class="number">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                02 / PENGENALAN POLA
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <h3>Mencari Pola</h3>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    Menemukan kesamaan atau pola dari berbagai
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    masalah sehingga solusi yang sama dapat
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    digunakan kembali.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </p>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </div>


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <div class="card">

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <div class="number">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            03 / ABSTRAKSI
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <h3>Mengambil Hal Penting</h3>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                Memusatkan perhatian pada informasi penting
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                dan mengabaikan informasi yang tidak
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                diperlukan.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </p>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <div class="card">

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <div class="number">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        04 / ALGORITMA
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <h3>Menyusun Langkah</h3>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            Membuat urutan langkah yang jelas dan
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            sistematis untuk mendapatkan solusi dari
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            suatu masalah.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </p>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </section>


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <!-- CONTOH -->
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <section id="contoh">

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <h2 class="title">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                CONTOH <span>DALAM KEHIDUPAN</span>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </h2>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <p class="subtitle">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                Berpikir komputasional tidak hanya digunakan
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        oleh programmer.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </p>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <div class="example">

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <h3>Contoh: Berangkat ke Sekolah</h3>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <p>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <b>Dekomposisi:</b>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        menentukan waktu bangun, mandi, sarapan,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    memakai seragam, dan berangkat.

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <br><br>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <b>Pengenalan Pola:</b>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        melihat kebiasaan waktu perjalanan dan
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    kondisi lalu lintas.

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <br><br>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <b>Abstraksi:</b>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fokus pada informasi penting seperti
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    waktu berangkat dan rute.

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <br><br>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <b>Algoritma:</b>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bangun → mandi → sarapan → memakai seragam
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    → mengambil perlengkapan → berangkat sekolah.

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </p>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </section>


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <!-- KESIMPULAN -->
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <section>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <h2 class="title">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <span>KESIMPULAN</span>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </h2>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <div class="example">

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        Berpikir komputasional membantu kita
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    menyelesaikan masalah dengan lebih teratur,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                logis, dan efisien. Kemampuan ini berguna
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            dalam pemrograman maupun dalam kehidupan
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        sehari-hari.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </p>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </section>


